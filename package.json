{
  "name": "dsh-hindsight-memory",
  "version": "0.1.1",
  "type": "module",
  "description": "Hindsight 记忆工作台：只读浏览本机 Hindsight 记忆库、统计、事实、关键词搜索、知识页与已安装技能",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaochouxia11/dsh-hindsight-memory"
  },
  "homepage": "https://github.com/xiaochouxia11/dsh-hindsight-memory#readme",
  "bugs": {
    "url": "https://github.com/xiaochouxia11/dsh-hindsight-memory/issues"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0-0",
    "node": ">=20"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "dist",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "docs/INSTALL.zh-CN.md",
    "docs/ACCEPTANCE.zh-CN.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "check:public-pack": "node scripts/check-public-pack.mjs"
  },
  "dependencies": {
    "@vectorize-io/hindsight-coding-agents": "0.8.8"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
